# Tracker api-backend — environment (NAMES documented; real values go in .env, never committed)
# Copy to .env and fill in. All secrets live ONLY here (backend). Never ship to frontend.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Primary datastore ---
# Local dev: the Compose Postgres. Staging/prod: the hosted Supabase Postgres connection string
# (use the connection POOLER endpoint for app concurrency — spec §3B).
DATABASE_URL=postgres://tracker:tracker_local_dev@localhost:5432/tracker

# --- Supabase (BACKEND ONLY — service_role NEVER leaves this process) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__set_me__
# Legacy HS256 secret — only used to verify HS256 test tokens. Real Supabase tokens on this
# project are ES256 and are verified via the public JWKS endpoint (no secret needed). Safe to
# leave as a placeholder in prod if the project uses asymmetric keys.
SUPABASE_JWT_SECRET=__set_me__

# --- Platform-admin surface (super-admin — separate auth from tenant users, spec §3C) ---
PLATFORM_ADMIN_JWT_SECRET=__set_me__

# --- Settings secrets at rest (integration API keys/tokens + SMTP password, AES-256-GCM) ---
# Required: 32 bytes as 64 hex chars or base64. Generate: openssl rand -hex 32
# Keep it stable and backed up — secrets encrypted with it are unreadable without it.
SETTINGS_ENC_KEY=__set_me__

# --- Hot layer ---
REDIS_URL=redis://localhost:6379

# --- ClickHouse analytics store (Phase 8) ---
# Optional: leave blank during Phase 0–7 if you're not running ClickHouse locally.
# The app boots without it; analytics surfaces guard on isClickHouseEnabled().
# Local dev: the Compose ClickHouse added for Phase 8.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=tracker
CLICKHOUSE_USER=default
# Set to the password configured for the ClickHouse service; never commit a real secret.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_REQUEST_TIMEOUT=10000
CLICKHOUSE_MAX_OPEN_CONNECTIONS=10

# --- Tracking ---
# Base domain for provisioned tenant subdomains (company.<this>) — spec §3D.
TRACKING_BASE_DOMAIN=ourtracking.com
# Extra proxies allowed to report the client IP via X-Forwarded-For on the tracking surface
# (comma-separated IPv4/IPv6 addresses or CIDRs). Loopback (127.0.0.1, ::1 — Nginx on the same
# host) and Cloudflare's published ranges are ALWAYS trusted; leave this unset unless a proxy or
# load balancer reaches the tracking server from another address. List only addresses you
# operate — anything listed here can set the click IP. Example uses documentation ranges only:
# TRACKING_TRUSTED_PROXIES=192.0.2.10,198.51.100.0/24,2001:db8::/64

# --- Ports (one per segregated surface — spec §2.1) ---
PORT_DASHBOARD=4001
PORT_TRACKING=4002
PORT_PUBLIC_API=4003
PORT_PLATFORM_ADMIN=4004
PORT_WORKERS_HEALTH=4005

# --- Later phases (documented now; unused until their phase) ---
# ANTHROPIC_API_KEY=__set_me__          # Phase 7 — AI ops layer (server-side only)
# MAXMIND_LICENSE_KEY=__set_me__        # Phase 2 — GeoIP2 local DB updates

# Tracker frontend — environment (Vite exposes only VITE_* to the browser).
# NEVER put a Supabase admin key, any token-signing secret, or backend credentials here.
# CI fails the build if a secret pattern appears in this repo (spec §3A).

# Backend Dashboard API base URL. In dev, leave blank to use the Vite proxy (/api → :4001).
VITE_API_BASE_URL=

# Supabase — ANON key ONLY, used solely for the Auth login flow to obtain a JWT.
# All application DATA still flows through the backend HTTP API, never Supabase directly (spec §2).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

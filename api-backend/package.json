{
  "name": "tracker-api-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Tracker — all server-side logic (tracking hot-path, Dashboard API, Public REST API, platform-admin, workers).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -n dashboard,tracking,public,platform,workers -c blue,green,cyan,magenta,yellow \"npm:dev:*\"",
    "dev:dashboard": "tsx watch src/surfaces/dashboard/main.ts",
    "dev:tracking": "tsx watch src/surfaces/tracking/main.ts",
    "dev:public-api": "tsx watch src/surfaces/public-api/main.ts",
    "dev:platform-admin": "tsx watch src/surfaces/platform-admin/main.ts",
    "dev:workers": "tsx watch src/surfaces/workers/main.ts",
    "start:dashboard": "node dist/surfaces/dashboard/main.js",
    "start:tracking": "node dist/surfaces/tracking/main.js",
    "start:public-api": "node dist/surfaces/public-api/main.js",
    "start:platform-admin": "node dist/surfaces/platform-admin/main.js",
    "start:workers": "node dist/surfaces/workers/main.js",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create -j sql",
    "seed": "tsx scripts/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-platform-admin.ts",
    "provision:demo-admin": "tsx scripts/provision-demo-admin.ts",
    "provision:demo-portals": "tsx scripts/provision-demo-portals.ts",
    "dev:localhost-domain": "tsx scripts/add-localhost-domain.ts",
    "tunnel": "tsx scripts/ngrok-tunnel.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "fraud-scan": "tsx scripts/fraud-scan.ts",
    "retention": "tsx scripts/retention.ts",
    "loadtest": "tsx scripts/loadtest-click.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:isolation": "vitest run test/isolation"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@sentry/node": "^8.26.0",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fastify": "^4.28.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "maxmind": "^4.3.24",
    "ngrok": "^5.0.0-beta.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "prom-client": "^15.1.3",
    "ua-parser-js": "^1.0.38",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "autocannon": "^7.15.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
